@{
    ViewData["Title"] = "Home Page";
}

<div class="home-page">

    <!-- HERO SECTION -->
    <section class="home-hero">
        <div class="home-hero-overlay">

            <div class="home-hero-content">
                <span class="home-badge">✈ SMART TRIP EXPERIENCE</span>

                <h1>
                    <span id="typing-title"></span><span class="typing-cursor">|</span>
                    <br />
                    <span class="second-line">Откривай повече.</span>
                </h1>

                <p>
                    Открий нови места и създай своето следващо приключение.
                    Ние ще ти помогнем да планираш пътуването според
                    твоите желания, бюджет и интереси.
                </p>

                <a href="#plan-trip" class="home-primary-button">
                    ✨ Планирай пътуване
                    <span>→</span>
                </a>
            </div>

            <div class="hero-benefits-card">
                <span class="benefits-eyebrow">ТВОЕТО ПЪТУВАНЕ</span>

                <div class="hero-benefits">
                    <div class="hero-benefit-item">
                        <div class="benefit-icon">✦</div>
                        <div>
                            <strong>По твой вкус</strong>
                            <p>Дестинации според интересите ти</p>
                        </div>
                    </div>

                    <div class="hero-benefit-item">
                        <div class="benefit-icon">€</div>
                        <div>
                            <strong>Според бюджета ти</strong>
                            <p>Планиране с мисъл за разходите</p>
                        </div>
                    </div>

                    <div class="hero-benefit-item">
                        <div class="benefit-icon">↗</div>
                        <div>
                            <strong>Лесно планиране</strong>
                            <p>По-малко чудене, повече приключения</p>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <div class="hero-bottom-label">
            <span class="hero-bottom-line"></span>
            YOUR JOURNEY STARTS HERE
        </div>
    </section>


    <!-- TRIP PLANNER SECTION -->
    <section class="trip-planner-section" id="plan-trip">

        <div class="home-section-heading">
            <span class="home-section-label">YOUR NEXT ADVENTURE</span>
            <h2>Накъде ще пътуваме?</h2>
            <p>
                Разкажи ни какво търсиш, а ние ще ти помогнем
                да организираш идеалното пътуване.
            </p>
        </div>

        <div class="trip-form-card">

            <div class="trip-form-header">
                <div class="form-header-icon">✈</div>
                <div>
                    <h3>Планирай своето пътуване</h3>
                    <p>Попълни информацията за своето приключение.</p>
                </div>
            </div>

            <form id="createTripForm" asp-controller="Trips" asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div id="tripForm" class="trip-form-grid">

                    <div class="trip-field field-full">
                        <label for="destination">Дестинация</label>
                        <div class="trip-input-wrapper">
                            <span>📍</span>
                            <input type="text"
                                   id="destination"
                                   name="destination"
                                   placeholder="Например: Рим, Италия"
                                   required />
                        </div>
                    </div>

                    <div class="trip-field">
                        <label for="startDate">Начална дата</label>
                        <input type="date"
                               id="startDate"
                               name="startDate"
                               required />
                    </div>

                    <div class="trip-field">
                        <label for="endDate">Крайна дата</label>
                        <input type="date"
                               id="endDate"
                               name="endDate"
                               required />
                    </div>

                    <div class="trip-field">
                        <label for="budget">Общ бюджет</label>
                        <div class="trip-input-wrapper">
                            <input type="number"
                                   id="budget"
                                   name="budget"
                                   placeholder="Например: 800"
                                   min="1"
                                   required />
                            <span class="input-suffix">€</span>
                        </div>
                    </div>

                    <div class="trip-field">
                        <label for="travelers">Брой пътуващи</label>
                        <select id="travelers" name="travelers">
                            <option value="1">1 човек</option>
                            <option value="2" selected>2 души</option>
                            <option value="3">3 души</option>
                            <option value="4">4 души</option>
                            <option value="5">5 души</option>
                            <option value="6">6 или повече</option>
                        </select>
                    </div>

                    <div class="trip-field field-full">
                        <label>Какъв тип пътуване предпочиташ?</label>

                        <div class="travel-type-options">
                            <label class="travel-option">
                                <input type="radio"
                                       name="travelType"
                                       value="Култура"
                                       checked />
                                <span>🏛️ Култура</span>
                            </label>

                            <label class="travel-option">
                                <input type="radio"
                                       name="travelType"
                                       value="Природа" />
                                <span>🏔️ Природа</span>
                            </label>

                            <label class="travel-option">
                                <input type="radio"
                                       name="travelType"
                                       value="Море" />
                                <span>🏖️ Море</span>
                            </label>

                            <label class="travel-option">
                                <input type="radio"
                                       name="travelType"
                                       value="Приключения" />
                                <span>🧗 Приключения</span>
                            </label>

                            <label class="travel-option">
                                <input type="radio"
                                       name="travelType"
                                       value="Релакс" />
                                <span>🌿 Релакс</span>
                            </label>
                        </div>
                    </div>

                    <div class="trip-field field-full">
                        <label>Какви типове преживявания предпочиташ? (Можеш да избереш няколко)</label>

                        <div class="travel-type-options">
                            <label class="travel-option">
                                <input type="checkbox" name="travelTypes" value="Култура и история" />
                                <span>🏛️ Култура и история</span>
                            </label>

                            <label class="travel-option">
                                <input type="checkbox" name="travelTypes" value="Местна кухня и гурме" />
                                <span>🍲 Местна кухня</span>
                            </label>

                            <label class="travel-option">
                                <input type="checkbox" name="travelTypes" value="Природа" />
                                <span>🏔️ Природа</span>
                            </label>

                            <label class="travel-option">
                                <input type="checkbox" name="travelTypes" value="Море" />
                                <span>🏖️ Море</span>
                            </label>

                            <label class="travel-option">
                                <input type="checkbox" name="travelTypes" value="Приключения" />
                                <span>🧗 Приключения</span>
                            </label>

                            <label class="travel-option">
                                <input type="checkbox" name="travelTypes" value="Релакс" />
                                <span>🌿 Релакс</span>
                            </label>
                        </div>
                    </div>

                    <button id="createTripButton" type="submit" class="trip-submit-button">
                        ✨ Създай моето приключение
                        <span>→</span>
                    </button>

                    <p id="createTripStatus" role="status" aria-live="polite" class="trip-form-note" hidden></p>

                    <p class="trip-form-note">
                        Персонализирано пътуване, съобразено с твоите желания.
                    </p>

                </form>
            </div>

        </section>


        <!-- DESTINATIONS SECTION -->
        <section class="destinations-section">

            <div class="destinations-heading">
                <div class="home-section-heading">
                    <span class="home-section-label">EXPLORE THE WORLD</span>
                    <h2>Открий следващата си дестинация</h2>
                    <p>
                        Вдъхнови се от някои от най-красивите места по света.
                    </p>
                </div>

                <a href="#plan-trip" class="view-all-link">
                    Планирай пътуване →
                </a>
            </div>

            <div class="destination-grid">

                <article class="destination-card">
                    <div class="destination-image">
                        <img src="/images/rome.jpg"
                             alt="Колизеумът в Рим" />
                        <span class="destination-tag">История и култура</span>
                    </div>
                    <div class="destination-info">
                        <div>
                            <h3>Рим, Италия</h3>
                            <p>🏛️ История, архитектура и италианска кухня</p>
                        </div>
                        <a href="#plan-trip"
                           class="destination-arrow"
                           aria-label="Планирай пътуване до Рим">↗</a>
                    </div>
                </article>

                <article class="destination-card">
                    <div class="destination-image">
                        <img src="/images/france.jpg"
                             alt="Айфеловата кула в Париж" />
                        <span class="destination-tag">Романтика</span>
                    </div>
                    <div class="destination-info">
                        <div>
                            <h3>Париж, Франция</h3>
                            <p>🗼 Изкуство, уютни кафенета и романтика</p>
                        </div>
                        <a href="#plan-trip"
                           class="destination-arrow"
                           aria-label="Планирай пътуване до Париж">↗</a>
                    </div>
                </article>

                <article class="destination-card">
                    <div class="destination-image">
                        <img src="/images/switzerland.jpg"
                             alt="Планински пейзаж и северно сияние" />
                        <span class="destination-tag">Природа</span>
                    </div>
                    <div class="destination-info">
                        <div>
                            <h3>Швейцария</h3>
                            <p>🏔️ Планини, езера и впечатляващи гледки</p>
                        </div>
                        <a href="#plan-trip"
                           class="destination-arrow"
                           aria-label="Планирай пътуване до Швейцария">↗</a>
                    </div>
                </article>

            </div>

        </section>


        <!-- WHY SMART TRIP SECTION -->
        <section class="why-smart-trip">

            <div class="why-smart-trip-content">
                <span class="home-section-label">TRAVEL SMARTER</span>
                <h2>По-малко планиране.<br />Повече преживявания.</h2>
                <p>
                    От избора на дестинация до последния детайл –
                    Smart TrIP ще ти помогне да организираш своето
                    следващо приключение на едно място.
                </p>

                <a asp-controller="Home"
                   asp-action="AboutUs"
                   class="home-secondary-button">
                    Научи повече за нас →
                </a>
            </div>

            <div class="why-smart-trip-decoration">
                <div class="decoration-circle">🌍</div>
                <span class="decoration-star star-one">✦</span>
                <span class="decoration-star star-two">✧</span>
                <span class="decoration-plane">✈</span>
            </div>

        </section>

    </div>

    <script>
        (() => {
            const form = document.getElementById('createTripForm');
            const button = document.getElementById('createTripButton');
            const status = document.getElementById('createTripStatus');
            if (!form || !button || !status) return;

            let submitting = false;
            form.addEventListener('submit', async (event) => {
                if (submitting) {
                    event.preventDefault();
                    return;
                }
                if (!form.checkValidity()) return;

                const start = document.getElementById('startDate')?.value;
                const end = document.getElementById('endDate')?.value;
                if (start && end) {
                    const days = Math.round((new Date(end + 'T12:00:00') - new Date(start + 'T12:00:00')) / 86400000) + 1;
                    if (days < 1 || days > 14) {
                        event.preventDefault();
                        alert(days < 1 ? 'Крайната дата не може да е преди началната.' : 'Пътуването може да бъде най-много 14 дни.');
                        return;
                    }
                }

                event.preventDefault();
                submitting = true;
                button.disabled = true;
                button.setAttribute('aria-busy', 'true');
                button.textContent = '⏳ Генерираме твоето приключение...';
                status.hidden = false;
                status.textContent = 'Gemini подготвя маршрута. Това може да отнеме известно време. Не натискай повторно бутона.';

                const slowMessage = setTimeout(() => {
                    status.textContent = 'Още работим по маршрута. Моля, изчакай — не изпращай формата повторно.';
                }, 30000);

                try {
                    const response = await fetch(form.action, {
                        method: 'POST',
                        body: new FormData(form),
                        headers: { 'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/json' },
                        credentials: 'same-origin',
                        cache: 'no-store'
                    });
                    const contentType = response.headers.get('content-type') || '';
                    if (!contentType.includes('application/json')) {
                        throw new Error('Сървърът върна неочакван отговор. Провери „Моите пътувания“, преди да опиташ отново.');
                    }
                    const result = await response.json();
                    if (!response.ok || !result.success || !result.url) {
                        throw new Error(result.message || 'Неуспешно създаване на пътуването.');
                    }
                    status.textContent = 'Пътуването е създадено! Отваряме маршрута...';
                    window.location.assign(result.url);
                } catch (error) {
                    status.textContent = (error && error.message ? error.message : 'Възникна проблем.') + ' Провери „Моите пътувания“, преди да създаваш ново.';
                    button.textContent = '✨ Създай моето приключение →';
                    button.disabled = false;
                    button.removeAttribute('aria-busy');
                    submitting = false;
                } finally {
                    clearTimeout(slowMessage);
                }
            });
        })();
    </script>
