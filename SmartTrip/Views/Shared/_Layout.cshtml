<!DOCTYPE html>
<html lang="bg">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SmartTrIP</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SmartTrip.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <nav class="navbar navbar-expand-lg smart-navbar">
            <div class="container">

                <!-- Logo -->
                <a class="navbar-brand smart-brand"
                   asp-controller="Home"
                   asp-action="Index">
                    <span class="brand-icon">✈</span>
                    <span>Smart <strong>TrIP</strong></span>
                </a>

                <!-- Mobile menu button -->
                <button class="navbar-toggler smart-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#smartNavbar"
                        aria-controls="smartNavbar"
                        aria-expanded="false"
                        aria-label="Отвори менюто">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Navigation links -->
                <div class="collapse navbar-collapse" id="smartNavbar">
                    <ul class="navbar-nav ms-auto align-items-lg-center">

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index"> Начало</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Trips" asp-action="Index"> Моите пътувания</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="AboutUs"> За нас</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Technologies"> Технологии</a>
                        </li>

                        <li class="nav-item nav-cta-item">
                            <a class="nav-cta"
                               asp-controller="Home"
                               asp-action="Index"
                               asp-fragment="plan-trip">
                                <span>+</span> Ново пътуване
                            </a>
                        </li>

                    </ul>
                </div>

            </div>
        </nav>
    </header>
    
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - SmartTrip - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
