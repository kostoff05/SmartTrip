@model SmartTrip.Models.Trip

@{
    ViewData["Title"] = "Пътуване до " + Model.City;


    string currentWeather =
        ViewBag.Weather as string
        ?? Model.WeatherInfo
        ?? "Няма информация";

    string travelTypes =
        !string.IsNullOrWhiteSpace(Model.TravelTypes)
            ? Model.TravelTypes
            : Model.TravelType ?? "Не е посочен";

    int? totalDays = null;

    if (Model.StartDate.HasValue && Model.EndDate.HasValue)
    {
        totalDays =
            (Model.EndDate.Value.Date -
             Model.StartDate.Value.Date).Days + 1;
    }
}

<div class="container trip-details-page py-5">

    <section class="trip-hero">

        <div class="trip-hero-overlay">

            <div class="trip-hero-top">

                <span class="trip-hero-label">
                    ✦ YOUR NEXT ADVENTURE
                </span>

            </div>

            <div class="trip-hero-content">

                <p class="trip-hero-subtitle">
                    ТВОЕТО СЛЕДВАЩО ПРИКЛЮЧЕНИЕ
                </p>

                <h1>
                    Моето пътуване до
                    <span>@Model.City</span>
                </h1>

                <p class="trip-hero-description">
                    Създадено на:
                    @Model.CreatedDate.ToString("dd.MM.yyyy HH:mm")
                </p>

                @if (Model.StartDate.HasValue &&
                     Model.EndDate.HasValue)
                {
                    <div class="trip-hero-info">

                        <span>
                            📅
                            @Model.StartDate.Value.ToString("dd.MM.yyyy")
                            –
                            @Model.EndDate.Value.ToString("dd.MM.yyyy")
                        </span>

                        <span>
                            🗓️ @totalDays дни
                        </span>

                        <span>
                            👥 @Model.Travelers пътуващи
                        </span>

                    </div>
                }

            </div>

            <div class="trip-hero-footer">
                <span>SMART TRIP</span>
                <span>EXPLORE · DISCOVER · EXPERIENCE</span>
            </div>

        </div>

    </section>

    <a asp-controller="Trips"
       asp-action="Index"
       class="btn btn-outline-secondary rounded-pill px-4">

        ← Всички пътувания

    </a>

    <div class="row g-3 mb-4">

        <!-- Бюджет -->

        <div class="col-md-3">

            <div class="info-card shadow-sm rounded-4 p-4 h-100">

                <div class="fs-2 mb-2">
                    💶
                </div>

                <p class="text-muted mb-1">
                    Общ бюджет
                </p>

                <h4 class="fw-bold mb-0">
                    @Model.Budget €
                </h4>

            </div>

        </div>


        <!-- Текущо време -->

        <div class="col-md-3">

            <div class="info-card shadow-sm rounded-4 p-4 h-100">

                <div class="fs-2 mb-2">
                    🌤️
                </div>

                <p class="text-muted mb-1">
                    Време в момента
                </p>

                <h5 id="current-weather" class="fw-bold text-success mb-0" aria-live="polite">
                    @currentWeather
                </h5>

            </div>

        </div>


        <!-- Тип пътуване -->

        <div class="col-md-3">

            <div class="info-card shadow-sm rounded-4 p-4 h-100">

                <div class="fs-2 mb-2">
                    🎒
                </div>

                <p class="text-muted mb-1">
                    Тип преживяване
                </p>

                <h5 class="fw-bold mb-0">
                    @travelTypes
                </h5>

            </div>

        </div>

        <!-- Валута на дестинацията -->
        <div class="col-md-3">

            <div class="info-card shadow-sm rounded-4 p-4 h-100">

                <div class="fs-2 mb-2">
                    💱
                </div>

                <p class="text-muted mb-1">
                    Валута на дестинацията
                </p>

                <h5 id="destination-currency"
                    class="fw-bold text-success mb-1"
                    aria-live="polite">
                    Зареждане...
                </h5>

                <small id="destination-country"
                       class="text-muted">
                </small>

            </div>

        </div>

    </div>

    @if (!string.IsNullOrWhiteSpace(Model.TripWeatherInfo))
    {
        <div class="card border-0 shadow-sm rounded-4 mb-4">

            <div class="card-body p-4 p-md-5">

                <h3 class="fw-bold mb-4">
                    🌦️ Времето през твоето пътуване
                </h3>

                @if (Model.StartDate.HasValue &&
                     Model.EndDate.HasValue)
                {
                    <p class="text-muted mb-4">
                        Прогноза за периода:

                        <strong>
                            @Model.StartDate.Value.ToString("dd.MM.yyyy")
                            –
                            @Model.EndDate.Value.ToString("dd.MM.yyyy")
                        </strong>
                    </p>
                }

                <div class="row g-4 align-items-center">

                    <!-- ТЕКСТ НА ПРОГНОЗАТА -->
                    <div class="col-lg-7">

                        <div class="weather-content">
                            @Model.TripWeatherInfo
                        </div>

                    </div>

                    <!-- СНИМКА -->
                    <div class="col-lg-5">

                        <div class="weather-image">
                            <img src="~/images/weather.jpg"
                                 alt="Пейзаж с красиво време по време на пътуване" />
                        </div>

                    </div>

                </div>

                <div class="alert alert-info mt-4 mb-0">
                    ℹ️ Прогнозата може да се промени.
                    За по-далечни дати информацията
                    може да бъде само ориентировъчна.
                </div>

            </div>

        </div>
    }

    <div class="card border-0 shadow-sm rounded-4 mb-4">

        <div class="card-body p-4 p-md-5">

            <div class="d-flex align-items-center
                gap-3 mb-4 pb-3 border-bottom">

                <div class="ai-icon">
                    🤖
                </div>

                <div>

                    <h3 class="fw-bold mb-1">
                        Твоят персонализиран AI пътеводител
                    </h3>

                    <p class="text-muted mb-0">

                        Маршрут по дни и часове,
                        бюджет и препоръки за багаж

                    </p>

                </div>

            </div>


            @if (!string.IsNullOrWhiteSpace(
                Model.AiRecommendation))
            {
                <div class="ai-content">

                    @Html.Raw(Model.AiRecommendation)

                </div>
            }
            else
            {
                <div class="alert alert-warning">

                    Все още няма генериран
                    AI пътеводител за това пътуване.

                </div>
            }


            <div class="alert alert-light border mt-4 mb-0">

                💡 <strong>Съвет:</strong>

                Часовете в маршрута са предложения.
                Провери работното време на
                забележителностите и наличността
                на билети преди посещението.

            </div>

        </div>

    </div>

    <div class="card border-0 shadow-sm rounded-4 mb-4">

        <div class="card-body p-4 p-md-5">

            <h3 class="fw-bold mb-3">

                📍 Карта на @Model.City

            </h3>

            <p class="text-muted mb-4">

                Разгледай района на дестинацията
                и планирай придвижването си.

            </p>

            <div class="ratio ratio-16x9
                rounded-4 overflow-hidden">

                <iframe src="https://www.google.com/maps?q=@Uri.EscapeDataString(Model.City)&amp;z=13&amp;output=embed"
                        title="Карта на @Model.City"
                        style="border:0;"
                        loading="lazy"
                        allowfullscreen>
                </iframe>

            </div>

        </div>

    </div>


    <div class="d-flex justify-content-between
        align-items-center flex-wrap gap-3">

        <a asp-controller="Trips"
           asp-action="Index"
           class="btn btn-outline-primary rounded-pill px-4">

            ← Назад към пътуванията

        </a>

        <a asp-controller="Trips"
           asp-action="Delete"
           asp-route-id="@Model.Id"
           class="btn btn-outline-danger rounded-pill px-4">

            🗑️ Изтрий пътуването

        </a>

    </div>

</div>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        const weatherElement = document.getElementById("current-weather");

        const weatherUrl = '@Url.Action("CurrentWeather", "Trips", new { id = Model.Id })';

        async function fetchWithTimeout(url, timeoutMs = 60000) {
            const controller = new AbortController();
            const timeout = setTimeout(() => controller.abort(), timeoutMs);
            try {
                const response = await fetch(url, {
                    signal: controller.signal,
                    headers: { "Accept": "application/json" }
                });
                if (!response.ok) throw new Error("HTTP " + response.status);
                return await response.json();
            } finally {
                clearTimeout(timeout);
            }
        }

        async function loadWeather() {
            try {
                const result = await fetchWithTimeout(weatherUrl);
                weatherElement.textContent = result.weather || "Няма налични данни за времето.";
            } catch {
                weatherElement.textContent = "Времето не е достъпно в момента.";
            }
        }


        
        // Зареждаме времето асинхронно, без да блокираме HTML страницата.
        loadWeather();
    });


    document.addEventListener("DOMContentLoaded", async function() {

        const currencyElement =
            document.getElementById("destination-currency");

        const countryElement =
            document.getElementById("destination-country");

        try {
            const response = await fetch(
                `/Trips/DestinationCurrency?id=@Model.Id`
            );

            if (!response.ok) {
                throw new Error("Грешка при заявката");
            }

            const data = await response.json();

            if (data.success) {

                currencyElement.textContent =
                    `${data.currencyName} (${data.currencyCode}) ${data.symbol}`;

                countryElement.textContent =
                    `Държава: ${data.country}`;

            } else {

                currencyElement.textContent =
                    "Няма налична информация";

            }

        } catch (error) {

            console.error("Грешка при валутата:", error);

            currencyElement.textContent =
                "Валутата не може да бъде заредена";

        }

    });

</script>