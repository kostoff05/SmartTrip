@model SmartTrip.Models.Trip

<div class="container mt-4">
    <h2>Детайли за пътуването 🌍</h2>
    <hr />

    <div class="card p-4 shadow-sm">
        <dl class="row">
            <dt class="col-sm-3">Дестинация (Град):</dt>
            <dd class="col-sm-9"><strong>@Model.City</strong></dd>

            <dt class="col-sm-3">Бюджет:</dt>
            <dd class="col-sm-9">@Model.Budget лв.</dd>

            <dt class="col-sm-3">Тип преживяване:</dt>
            <dd class="col-sm-9">@Model.TravelTypes</dd>

            <dt class="col-sm-3">Интереси:</dt>
            <dd class="col-sm-9">@(string.IsNullOrEmpty(Model.Interests) ? "Няма въведени" : Model.Interests)</dd>

            <dt class="col-sm-3">Информация за времето:</dt>
            <dd class="col-sm-9 text-success">@Model.WeatherInfo</dd>

            <dt class="col-sm-3">Дата на създаване:</dt>
            <dd class="col-sm-9">@Model.CreatedDate.ToString("dd.MM.yyyy HH:mm")</dd>
        </dl>

        <div class="mt-3 d-flex justify-content-between align-items-center">
            <a asp-action="Index" class="btn btn-secondary">← Обратно към списъка</a>

            <!-- Бутон за изтриване директно от детайлите -->
            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Сигурни ли сте, че искате да изтриете това пътуване?');">
                <button type="submit" class="btn btn-danger">Изтрий пътуването</button>
            </form>
        </div>
    </div>
</div>