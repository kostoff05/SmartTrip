@model IEnumerable<SmartTrip.Models.Trip>

<div class="container mt-4">
    <h2>Моите пътувания 🌍</h2>
    <hr />

    @if (Model != null && Model.Any())
    {
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Град</th>
                    <th>Бюджет</th>
                    <th>Информация за времето</th>
                    <th class="text-end">Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var trip in Model)
                {
                    <tr>
                        <td>@trip.City</td>
                        <td>@trip.Budget лв.</td>
                        <td>@trip.WeatherInfo</td>
                        <td class="text-end">
                            <!-- Бутон за детайли -->
                            <a asp-action="Details" asp-route-id="@trip.Id" class="btn btn-sm btn-info text-white">Детайли</a>

                            <!-- Форма за изтриване -->
                            <form asp-action="Delete" asp-route-id="@trip.Id" method="post" class="d-inline" onsubmit="return confirm('Сигурни ли сте, че искате да изтриете това пътуване?');">
                                <button type="submit" class="btn btn-sm btn-danger">Изтрий</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="alert alert-info">
            Все още няма добавени пътувания в базата данни!
        </div>
    }
</div>