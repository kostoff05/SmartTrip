@model IEnumerable<SmartTrip.Models.Trip>

<div class="container py-5">
    <div class="row mb-4 align-items-center">
        <div class="col">
            <h1 class="fw-bold text-dark">Моите пътувания <span class="fs-2">🌍</span></h1>
            <p class="text-muted">Всички ваши запазени дестинации и приключения на едно място.</p>
        </div>
        <div class="col-auto">
            <a asp-controller="Home" asp-action="Index" asp-fragment="plan-trip" class="btn btn-primary rounded-pill px-4 shadow-sm">
                <i class="bi bi-plus-lg"></i> + Ново пътуване
            </a>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var trip in Model)
            {
                <div class="col">
                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden transition-card">
                        <div class="card-body p-4 d-flex flex-column">
                            <!-- Заглавие на дестинацията -->
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <h3 class="fw-bold text-primary mb-0">@trip.City</h3>
                                <span class="badge bg-light text-dark border px-3 py-2 rounded-pill fw-semibold">
                                    💰 @trip.Budget €
                                </span>
                            </div>

                            <!-- Информация за времето -->
                            <p class="text-secondary mb-4 flex-grow-1">
                                <i class="bi bi-cloud-sun me-1"></i> <strong>Време:</strong> @trip.WeatherInfo
                            </p>

                            <!-- Бутони за действия -->
                            <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                                <a asp-action="Details" asp-route-id="@trip.Id" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                                    Детайли
                                </a>

                                <form asp-action="Delete" asp-route-id="@trip.Id" method="post" class="d-inline" onsubmit="return confirm('Сигурни ли сте, че искате да изтриете това пътуване?');">
                                    <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3 border-0">
                                        Изтрий
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5 bg-light rounded-4 shadow-sm">
            <h4 class="text-muted mb-3">Все още няма добавени пътувания!</h4>
            <p class="text-secondary mb-4">Започнете като планирате първото си невероятно приключение.</p>
            <a asp-action="Create" class="btn btn-primary rounded-pill px-4">Планирай сега</a>
        </div>
    }
</div>

<style>
    /* Лека анимация при мишка върху карточката */
    .transition-card {
        transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
    }
    .transition-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 .5rem 1rem rgba(0,0,0,.15)!important;
    }
</style>