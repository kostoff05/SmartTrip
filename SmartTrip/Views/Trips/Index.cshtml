@model IEnumerable<SmartTrip.Models.Trip>

@{
    ViewData["Title"] = "Моите пътувания";
}

<div class="trips-page">

    <!-- HERO SECTION -->
    <section class="trips-hero">
        <div class="trips-hero-decoration trips-decoration-one"></div>
        <div class="trips-hero-decoration trips-decoration-two"></div>

        <div class="container trips-hero-content">

            <div class="trips-eyebrow">
                <span>✦</span> YOUR TRAVEL COLLECTION
            </div>

            <h1>
                Моите пътувания<span>.</span>
            </h1>

            <p>
                Всяко приключение започва с една идея.
                Съхрани любимите си планове и открий
                следващата си дестинация със Smart TrIP.
            </p>

            <a asp-controller="Home"
               asp-action="Index"
               asp-fragment="plan-trip"
               class="trips-primary-button">
                <span>＋</span>
                Планирай ново пътуване
                <span class="trips-button-arrow">→</span>
            </a>

        </div>
    </section>

    <!-- SAVED TRIPS -->
    <section class="trips-content container">

        
        <div class="trips-section-heading">
            <div class="trips-section-info">
                <span class="trips-section-label">YOUR ADVENTURES</span>
                <h2>Твоята колекция</h2>
                <p>Всички твои планове, събрани на едно място.</p>
            </div>

            @if (Model != null && Model.Any())
            {
                <div class="trips-summary">
                    <div class="trips-summary-icon">✈</div>
                    <div>
                        <strong>@Model.Count()</strong>
                        <span>
                            @(Model.Count() == 1
                                ? "запазено пътуване"
                                : "запазени пътувания")
                        </span>
                    </div>
                </div>
            }
        </div>


        @if (Model == null || !Model.Any())
        {
            <!-- EMPTY STATE -->
            <div class="trips-empty-state">

                <div class="empty-illustration">
                    <div class="empty-sun"></div>
                    <div class="empty-cloud">☁</div>
                    <div class="empty-globe">🌍</div>
                    <div class="empty-plane">✈</div>
                    <div class="empty-star empty-star-one">✦</div>
                    <div class="empty-star empty-star-two">✧</div>
                </div>

                <span class="empty-label">ТВОЕТО СЛЕДВАЩО ПРИКЛЮЧЕНИЕ</span>

                <h2>Още не си поел на път?</h2>

                <p>
                    Тук ще откриеш всички пътувания, които планираш.
                    Създай първото си и превърни идеята си в приключение!
                </p>

                <a asp-controller="Home"
                   asp-action="Index"
                   asp-fragment="plan-trip"
                   class="trips-primary-button">
                    ✨ Създай първото си пътуване
                    <span class="trips-button-arrow">→</span>
                </a>

            </div>
        }
        else
        {
            <div class="trips-grid">

                @foreach (var trip in Model)
                {
                    <article class="trip-card">

                        <div class="trip-card-top">

                            <div class="trip-card-icon">✈</div>

                            <div class="trip-card-decoration">✦</div>

                            <div class="trip-card-destination">
                                <span>ТВОЯТА ДЕСТИНАЦИЯ</span>
                                <h3>📍 @trip.City</h3>
                            </div>

                        </div>

                        <div class="trip-card-body">

                            <div class="trip-created">
                                <span>Добавено в колекцията</span>
                                <strong>
                                    @trip.CreatedDate.ToString("dd.MM.yyyy")
                                </strong>
                            </div>

                            <div class="trip-info-grid">

                                <div class="trip-info-item">
                                    <span class="trip-info-icon">📅</span>
                                    <div>
                                        <small>Период</small>
                                        <strong>
                                            @if (trip.StartDate.HasValue &&
                                                 trip.EndDate.HasValue)
                                            {
                                                @trip.StartDate.Value.ToString("dd.MM.yyyy")
                                                <span> – </span>
                                                @trip.EndDate.Value.ToString("dd.MM.yyyy")
                                            }
                                            else
                                            {
                                                <span>Не е посочен</span>
                                            }
                                        </strong>
                                    </div>
                                </div>

                                <div class="trip-info-item">
                                    <span class="trip-info-icon">👥</span>
                                    <div>
                                        <small>Пътуващи</small>
                                        <strong>
                                            @(trip.Travelers > 0
                                                ? trip.Travelers
                                                : 2)
                                        </strong>
                                    </div>
                                </div>

                                <div class="trip-info-item">
                                    <span class="trip-info-icon">💶</span>
                                    <div>
                                        <small>Бюджет</small>
                                        <strong>@trip.Budget €</strong>
                                    </div>
                                </div>

                                <div class="trip-info-item">
                                    <span class="trip-info-icon">🧭</span>
                                    <div>
                                        <small>Тип пътуване</small>
                                        <strong>@trip.TravelType</strong>
                                    </div>
                                </div>

                            </div>

                            <div class="trip-card-actions">

                                <a asp-controller="Trips"
                                   asp-action="Details"
                                   asp-route-id="@trip.Id"
                                   class="trip-details-button">
                                    Виж пътуването
                                    <span>→</span>
                                </a>

                                <a asp-controller="Trips"
                                   asp-action="Delete"
                                   asp-route-id="@trip.Id"
                                   class="trip-delete-button"
                                   title="Изтрий пътуването"
                                   aria-label="Изтрий пътуването">
                                    🗑
                                </a>

                            </div>

                        </div>

                    </article>
                }

            </div>
        }

        <!-- BOTTOM NOTE -->
        <div class="trips-bottom-note">
            <span>✦</span>
            <p>
                Светът е голям, а твоите приключения тепърва започват.
            </p>
            <span>✦</span>
        </div>

    </section>

</div>
