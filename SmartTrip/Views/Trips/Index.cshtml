@model IEnumerable<SmartTrip.Models.Trip>

@{
    ViewData["Title"] = "Моите пътувания";
}

<div class="container py-5">

    <div class="text-center mb-5">
        <h1 class="fw-bold">✈️ Моите пътувания</h1>

        <p class="text-muted">
            Разгледай всички приключения, които си планирал със SmartTrip.
        </p>

        <a asp-controller="Home"
           asp-action="Index"
           asp-fragment="plan-trip"
           class="btn btn-primary mt-3">
            ✨ Планирай ново пътуване
        </a>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="text-center p-5 bg-light rounded-4">

            <h2>🌍 Все още нямаш пътувания</h2>

            <p class="text-muted mt-3">
                Време е да планираш първото си приключение!
            </p>

            <a asp-controller="Home"
               asp-action="Index"
               asp-fragment="plan-trip"
               class="btn btn-success mt-3">
                Създай първото си пътуване
            </a>

        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var trip in Model)
            {
                <div class="col-md-6 col-lg-4">

                    <div class="card h-100 shadow-sm border-0 rounded-4">

                        <div class="card-body p-4">

                            <h3 class="card-title fw-bold">
                                📍 @trip.City
                            </h3>

                            <p class="text-muted">
                                🗓️ Създадено на:
                                @trip.CreatedDate.ToString("dd.MM.yyyy")
                            </p>

                            @if (trip.StartDate.HasValue &&
                                 trip.EndDate.HasValue)
                            {
                                <p>
                                    📅
                                    @trip.StartDate.Value.ToString("dd.MM.yyyy")
                                    -
                                    @trip.EndDate.Value.ToString("dd.MM.yyyy")
                                </p>
                            }

                            <p>
                                👥 Пътуващи:
                                @(trip.Travelers > 0 ? trip.Travelers : 2)
                            </p>

                            <p>
                                💶 Бюджет:
                                @trip.Budget €
                            </p>

                            <p>
                                🎯 Тип:
                                @trip.TravelType
                            </p>

                            <div class="d-flex gap-2 mt-4">

                                <a asp-controller="Trips"
                                   asp-action="Details"
                                   asp-route-id="@trip.Id"
                                   class="btn btn-primary flex-grow-1">
                                    👁️ Детайли
                                </a>

                                <a asp-controller="Trips"
                                   asp-action="Delete"
                                   asp-route-id="@trip.Id"
                                   class="btn btn-outline-danger">
                                    🗑️
                                </a>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>